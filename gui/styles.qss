/* 
 * Lab-untuk-OCR - Gen Z Modern UI
 * Design: Bold, Vibrant, Playful, Professional
 * No Gradients | Pure Qt Power
 */

/* ============================================================================
   GLOBAL - Fresh Modern Background
   ============================================================================ */

QMainWindow {
    background-color: #F0F4F8;
}

QWidget {
    font-family: "Inter", -apple-system, "Segoe UI", sans-serif;
    font-size: 10pt;
    color: #0F172A;
}

/* ============================================================================
   BUTTONS - Bold Gen Z Style
   ============================================================================ */

QPushButton {
    background-color: #3B82F6;
    color: white;
    border: none;
    border-radius: 12px;
    padding: 14px 28px;
    font-weight: 700;
    font-size: 11pt;
    min-height: 48px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

QPushButton:hover {
    background-color: #2563EB;
    padding: 15px 28px 13px 28px;
}

QPushButton:pressed {
    background-color: #1E40AF;
    padding: 16px 28px 12px 28px;
}

QPushButton:disabled {
    background-color: #E2E8F0;
    color: #94A3B8;
}

/* Browse Button - Bold Outline */
QPushButton#browse_btn {
    background-color: transparent;
    color: #3B82F6;
    border: 3px solid #3B82F6;
    font-weight: 800;
}

QPushButton#browse_btn:hover {
    background-color: #3B82F6;
    color: white;
    border: 3px solid #3B82F6;
}

QPushButton#browse_btn:pressed {
    background-color: #2563EB;
    border: 3px solid #2563EB;
}

/* Start Button - Vibrant Green */
QPushButton#start_btn {
    background-color: #10B981;
    color: white;
    border: none;
}

QPushButton#start_btn:hover {
    background-color: #059669;
}

QPushButton#start_btn:pressed {
    background-color: #047857;
}

QPushButton#start_btn:disabled {
    background-color: #E2E8F0;
    color: #94A3B8;
}

/* Reset Button - Bold Red Outline */
QPushButton#reset_btn {
    background-color: transparent;
    color: #EF4444;
    border: 3px solid #EF4444;
    font-weight: 800;
}

QPushButton#reset_btn:hover {
    background-color: #EF4444;
    color: white;
    border: 3px solid #EF4444;
}

QPushButton#reset_btn:pressed {
    background-color: #DC2626;
    border: 3px solid #DC2626;
}

QPushButton#reset_btn:disabled {
    background-color: transparent;
    color: #CBD5E1;
    border: 3px solid #CBD5E1;
}

/* Export Button - Vibrant Purple */
QPushButton#exportButton {
    background-color: #8B5CF6;
    color: white;
    font-size: 12pt;
    min-height: 52px;
}

QPushButton#exportButton:hover {
    background-color: #7C3AED;
}

QPushButton#exportButton:pressed {
    background-color: #6D28D9;
}

/* ============================================================================
   GROUP BOX - Modern Card Style
   ============================================================================ */

QGroupBox {
    background-color: #FFFFFF;
    border: none;
    border-radius: 20px;
    padding: 28px;
    margin-top: 20px;
    font-weight: 800;
    font-size: 13pt;
    color: #0F172A;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 6px 20px;
    background-color: #0F172A;
    color: #FFFFFF;
    border-radius: 10px;
    font-weight: 800;
    letter-spacing: 1px;
}

/* ============================================================================
   TABLE - Modern Vibrant Design
   ============================================================================ */

QTableWidget {
    background-color: #FFFFFF;
    border: none;
    border-radius: 16px;
    gridline-color: #E2E8F0;
    selection-background-color: #DBEAFE;
    selection-color: #0F172A;
    font-size: 10pt;
}

QTableWidget::item {
    padding: 14px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #BFDBFE;
    color: #1E40AF;
    font-weight: 600;
}

QTableWidget::item:hover {
    background-color: #F1F5F9;
}

QTableWidget::item:focus {
    background-color: #93C5FD;
    outline: none;
}

/* Table Header - Bold & Modern */
QHeaderView::section {
    background-color: #1E293B;
    color: #FFFFFF;
    padding: 16px 14px;
    border: none;
    border-right: 2px solid #334155;
    font-weight: 800;
    font-size: 9pt;
    text-transform: uppercase;
    letter-spacing: 1.5px;
}

QHeaderView::section:hover {
    background-color: #334155;
}

QHeaderView::section:first {
    border-top-left-radius: 16px;
}

QHeaderView::section:last {
    border-top-right-radius: 16px;
}

/* Vertical Header - Vibrant Accent */
QHeaderView::section:vertical {
    background-color: #3B82F6;
    color: #FFFFFF;
    font-weight: 800;
    font-size: 11pt;
    border-bottom: 2px solid #2563EB;
}

/* ============================================================================
   PROGRESS BAR - Bold Modern Style
   ============================================================================ */

QProgressBar {
    background-color: #E2E8F0;
    border: none;
    border-radius: 14px;
    text-align: center;
    height: 36px;
    font-size: 11pt;
    font-weight: 700;
    color: #0F172A;
}

QProgressBar::chunk {
    background-color: #10B981;
    border-radius: 14px;
}

/* ============================================================================
   STATUS BAR - Clean Minimal
   ============================================================================ */

QStatusBar {
    background-color: #1E293B;
    color: #94A3B8;
    border: none;
    font-size: 10pt;
    font-weight: 600;
    padding: 10px 16px;
}

/* ============================================================================
   SCROLL BAR - Modern Bold
   ============================================================================ */

QScrollBar:vertical {
    background-color: #F1F5F9;
    width: 16px;
    border-radius: 8px;
    margin: 6px;
}

QScrollBar::handle:vertical {
    background-color: #3B82F6;
    border-radius: 8px;
    min-height: 50px;
}

QScrollBar::handle:vertical:hover {
    background-color: #2563EB;
}

QScrollBar:horizontal {
    background-color: #F1F5F9;
    height: 16px;
    border-radius: 8px;
    margin: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #3B82F6;
    border-radius: 8px;
    min-width: 50px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #2563EB;
}

QScrollBar::add-line, QScrollBar::sub-line {
    background: none;
    border: none;
}

/* ============================================================================
   LABELS - Bold Hierarchy
   ============================================================================ */

QLabel {
    color: #1E293B;
    font-weight: 600;
}

/* ============================================================================
   DIALOG - Modern Bold
   ============================================================================ */

QDialog {
    background-color: #F8FAFC;
}

QRadioButton {
    color: #1E293B;
    spacing: 12px;
    padding: 10px;
    font-weight: 600;
    font-size: 10pt;
}

QRadioButton::indicator {
    width: 24px;
    height: 24px;
    border: 3px solid #64748B;
    border-radius: 12px;
    background-color: #FFFFFF;
}

QRadioButton::indicator:checked {
    background-color: #3B82F6;
    border-color: #3B82F6;
}

QRadioButton::indicator:hover {
    border-color: #3B82F6;
    background-color: #EFF6FF;
}

QDialogButtonBox QPushButton {
    min-width: 120px;
    padding: 12px 24px;
    font-weight: 700;
}

/* ============================================================================
   MESSAGE BOX - Bold Modern
   ============================================================================ */

QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #0F172A;
    font-size: 11pt;
    font-weight: 500;
}

QMessageBox QPushButton {
    min-width: 120px;
    padding: 12px 24px;
    font-weight: 700;
    font-size: 10pt;
}

/* ============================================================================
   TOOLTIPS - Vibrant
   ============================================================================ */

QToolTip {
    background-color: #0F172A;
    color: #FFFFFF;
    border: 3px solid #3B82F6;
    border-radius: 10px;
    padding: 10px 16px;
    font-size: 10pt;
    font-weight: 600;
}

/* ============================================================================
   INPUT FIELDS - Modern Bold
   ============================================================================ */

QLineEdit {
    background-color: #FFFFFF;
    border: 3px solid #E2E8F0;
    border-radius: 12px;
    padding: 12px 16px;
    font-size: 11pt;
    font-weight: 500;
    color: #0F172A;
}

QLineEdit:focus {
    border: 3px solid #3B82F6;
}

QLineEdit:hover {
    border: 3px solid #94A3B8;
}

QLineEdit:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
    border: 3px solid #E2E8F0;
}

/* ============================================================================
   SPECIAL EFFECTS - Gen Z Vibes
   ============================================================================ */

/* File Selection Label - When File Selected */
QLabel#file_selected {
    background-color: #D1FAE5;
    color: #047857;
    border-radius: 10px;
    padding: 12px 20px;
    font-weight: 700;
}

/* Success State */
.success {
    background-color: #10B981;
    color: white;
}

/* Error State */
.error {
    background-color: #EF4444;
    color: white;
}

/* Warning State */
.warning {
    background-color: #F59E0B;
    color: white;
}
