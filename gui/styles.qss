/* 
 * Lab-untuk-OCR Modern Glassmorphism UI
 * Design: Glass, Blur, Depth, Modern
 * Following Material Design & Apple HIG principles
 */

/* ============================================================================
   GLOBAL - Modern Background
   ============================================================================ */

QMainWindow {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #E0E7FF,
        stop:1 #F0F4FF
    );
}

QWidget {
    font-family: -apple-system, "Segoe UI", "Roboto", sans-serif;
    font-size: 10pt;
    color: #1E293B;
}

/* ============================================================================
   BUTTONS - Glassmorphism with Depth
   ============================================================================ */

QPushButton {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(59, 130, 246, 0.9),
        stop:1 rgba(37, 99, 235, 0.95)
    );
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    padding: 12px 24px;
    font-weight: 600;
    font-size: 10pt;
    min-height: 40px;
    box-shadow: 0 4px 15px rgba(37, 99, 235, 0.3);
}

QPushButton:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(96, 165, 250, 0.95),
        stop:1 rgba(59, 130, 246, 1.0)
    );
    border: 1px solid rgba(255, 255, 255, 0.3);
}

QPushButton:pressed {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(29, 78, 216, 1.0),
        stop:1 rgba(30, 64, 175, 1.0)
    );
    padding: 13px 24px 11px 24px;
}

QPushButton:disabled {
    background: rgba(203, 213, 225, 0.5);
    color: rgba(148, 163, 184, 0.8);
    border: 1px solid rgba(203, 213, 225, 0.3);
}

/* Browse Button - Glass Outline */
QPushButton#browse_btn {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(10px);
    color: #2563EB;
    border: 2px solid rgba(37, 99, 235, 0.3);
    font-weight: 600;
}

QPushButton#browse_btn:hover {
    background: rgba(255, 255, 255, 0.9);
    border: 2px solid rgba(37, 99, 235, 0.5);
}

/* Start Button - Accent */
QPushButton#start_btn {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(16, 185, 129, 0.9),
        stop:1 rgba(5, 150, 105, 0.95)
    );
    border: 1px solid rgba(255, 255, 255, 0.2);
}

QPushButton#start_btn:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(52, 211, 153, 0.95),
        stop:1 rgba(16, 185, 129, 1.0)
    );
}

QPushButton#start_btn:disabled {
    background: rgba(203, 213, 225, 0.5);
}

/* Reset Button - Warning style */
QPushButton#reset_btn {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(10px);
    color: #DC2626;
    border: 2px solid rgba(220, 38, 38, 0.3);
    font-weight: 600;
}

QPushButton#reset_btn:hover {
    background: rgba(254, 226, 226, 0.9);
    border: 2px solid rgba(220, 38, 38, 0.5);
}

/* Export Button */
QPushButton#exportButton {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(139, 92, 246, 0.9),
        stop:1 rgba(124, 58, 237, 0.95)
    );
}

QPushButton#exportButton:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(167, 139, 250, 0.95),
        stop:1 rgba(139, 92, 246, 1.0)
    );
}

/* ============================================================================
   GROUP BOX - Glass Cards with Depth
   ============================================================================ */

QGroupBox {
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 16px;
    padding: 24px;
    margin-top: 16px;
    font-weight: 700;
    font-size: 12pt;
    color: #1E293B;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 16px;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 8px;
    color: #1E293B;
}

/* ============================================================================
   TABLE - Glass with Depth
   ============================================================================ */

QTableWidget {
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(15px);
    border: 1px solid rgba(226, 232, 240, 0.5);
    border-radius: 12px;
    gridline-color: rgba(226, 232, 240, 0.6);
    selection-background-color: rgba(219, 234, 254, 0.7);
    selection-color: #1E293B;
}

QTableWidget::item {
    padding: 12px;
    border: none;
}

QTableWidget::item:selected {
    background: rgba(219, 234, 254, 0.8);
    border-radius: 4px;
}

QTableWidget::item:hover {
    background: rgba(241, 245, 249, 0.6);
}

/* Table Header - Glass */
QHeaderView::section {
    background: rgba(248, 250, 252, 0.95);
    backdrop-filter: blur(10px);
    color: #475569;
    padding: 14px 12px;
    border: none;
    border-bottom: 2px solid rgba(226, 232, 240, 0.7);
    border-right: 1px solid rgba(226, 232, 240, 0.5);
    font-weight: 700;
    font-size: 9pt;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QHeaderView::section:hover {
    background: rgba(241, 245, 249, 1.0);
}

/* Vertical Header (Row Numbers) */
QHeaderView::section:vertical {
    background: rgba(239, 246, 255, 0.9);
    color: #3B82F6;
    font-weight: 700;
    font-size: 10pt;
}

/* ============================================================================
   PROGRESS BAR - Glass with Animation Feel
   ============================================================================ */

QProgressBar {
    background: rgba(241, 245, 249, 0.7);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(203, 213, 225, 0.4);
    border-radius: 12px;
    text-align: center;
    height: 32px;
    font-size: 10pt;
    font-weight: 600;
    color: #1E293B;
}

QProgressBar::chunk {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(59, 130, 246, 0.9),
        stop:0.5 rgba(96, 165, 250, 0.95),
        stop:1 rgba(59, 130, 246, 0.9)
    );
    border-radius: 11px;
}

/* ============================================================================
   STATUS BAR - Minimal Glass
   ============================================================================ */

QStatusBar {
    background: rgba(248, 250, 252, 0.8);
    backdrop-filter: blur(15px);
    color: #64748B;
    border-top: 1px solid rgba(226, 232, 240, 0.6);
    font-size: 9pt;
    padding: 6px 12px;
}

/* ============================================================================
   SCROLL BAR - Modern Minimal
   ============================================================================ */

QScrollBar:vertical {
    background: rgba(241, 245, 249, 0.5);
    width: 14px;
    border-radius: 7px;
    margin: 4px;
}

QScrollBar::handle:vertical {
    background: rgba(148, 163, 184, 0.5);
    border-radius: 7px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(100, 116, 139, 0.7);
}

QScrollBar:horizontal {
    background: rgba(241, 245, 249, 0.5);
    height: 14px;
    border-radius: 7px;
    margin: 4px;
}

QScrollBar::handle:horizontal {
    background: rgba(148, 163, 184, 0.5);
    border-radius: 7px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(100, 116, 139, 0.7);
}

QScrollBar::add-line, QScrollBar::sub-line {
    background: none;
    border: none;
}

/* ============================================================================
   LABELS - Hierarchy
   ============================================================================ */

QLabel {
    color: #334155;
    font-weight: 500;
}

/* ============================================================================
   DIALOG - Glass
   ============================================================================ */

QDialog {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
}

QRadioButton {
    color: #334155;
    spacing: 10px;
    padding: 8px;
    font-weight: 500;
}

QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(148, 163, 184, 0.6);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.9);
}

QRadioButton::indicator:checked {
    background: qradialgradient(
        cx:0.5, cy:0.5, radius:0.5,
        stop:0 #3B82F6,
        stop:0.7 #3B82F6,
        stop:1 rgba(59, 130, 246, 0.8)
    );
    border-color: #3B82F6;
}

QRadioButton::indicator:hover {
    border-color: #3B82F6;
    background: rgba(239, 246, 255, 0.9);
}

QDialogButtonBox QPushButton {
    min-width: 100px;
    padding: 10px 20px;
}

/* ============================================================================
   MESSAGE BOX - Glass
   ============================================================================ */

QMessageBox {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
}

QMessageBox QPushButton {
    min-width: 100px;
    padding: 10px 20px;
}

/* ============================================================================
   TOOLTIPS - Modern
   ============================================================================ */

QToolTip {
    background: rgba(30, 41, 59, 0.95);
    backdrop-filter: blur(10px);
    color: white;
    border: 1px solid rgba(100, 116, 139, 0.3);
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 9pt;
}
