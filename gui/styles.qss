/* 
 * Lab-untuk-OCR Professional UI Stylesheet
 * Design: Clean, Minimal, Professional
 * Color: Single professional blue tone
 */

/* ============================================================================
   GLOBAL STYLES
   ============================================================================ */

QMainWindow {
    background-color: #F9FAFB;
}

QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
    color: #1F2937;
}

/* ============================================================================
   BUTTONS - Single Professional Color
   ============================================================================ */

QPushButton {
    background-color: #2563EB;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: 500;
    font-size: 10pt;
    min-height: 36px;
}

QPushButton:hover {
    background-color: #1D4ED8;
}

QPushButton:pressed {
    background-color: #1E40AF;
}

QPushButton:disabled {
    background-color: #D1D5DB;
    color: #9CA3AF;
}

/* Browse Button - Outline Style */
QPushButton#browse_btn {
    background-color: #FFFFFF;
    color: #2563EB;
    border: 2px solid #2563EB;
}

QPushButton#browse_btn:hover {
    background-color: #EFF6FF;
}

/* Export Button */
QPushButton#exportButton {
    background-color: #2563EB;
    color: white;
}

QPushButton#exportButton:hover {
    background-color: #1D4ED8;
}

/* ============================================================================
   GROUP BOX (Cards) - Minimal Design
   ============================================================================ */

QGroupBox {
    background-color: white;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 16px;
    margin-top: 12px;
    font-weight: 600;
    font-size: 11pt;
    color: #1F2937;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    background-color: white;
}

/* ============================================================================
   TABLE - Clean Professional
   ============================================================================ */

QTableWidget {
    background-color: white;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    gridline-color: #E5E7EB;
    selection-background-color: #DBEAFE;
    selection-color: #1F2937;
}

QTableWidget::item {
    padding: 8px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #DBEAFE;
}

/* Table Header */
QHeaderView::section {
    background-color: #F3F4F6;
    color: #374151;
    padding: 10px;
    border: none;
    border-bottom: 2px solid #E5E7EB;
    border-right: 1px solid #E5E7EB;
    font-weight: 600;
    font-size: 9pt;
}

QHeaderView::section:hover {
    background-color: #E5E7EB;
}

/* ============================================================================
   PROGRESS BAR - Professional
   ============================================================================ */

QProgressBar {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    background-color: #F3F4F6;
    text-align: center;
    height: 24px;
    font-size: 9pt;
    color: #1F2937;
}

QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 5px;
}

/* ============================================================================
   STATUS BAR - Minimal
   ============================================================================ */

QStatusBar {
    background-color: #F9FAFB;
    color: #6B7280;
    border-top: 1px solid #E5E7EB;
    font-size: 9pt;
}

/* ============================================================================
   SCROLL BAR - Clean
   ============================================================================ */

QScrollBar:vertical {
    background-color: #F3F4F6;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #D1D5DB;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9CA3AF;
}

QScrollBar:horizontal {
    background-color: #F3F4F6;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #D1D5DB;
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #9CA3AF;
}

QScrollBar::add-line, QScrollBar::sub-line {
    background: none;
    border: none;
}

/* ============================================================================
   DIALOG - Professional
   ============================================================================ */

QDialog {
    background-color: white;
}

QLabel {
    color: #374151;
}

QRadioButton {
    color: #374151;
    spacing: 8px;
    padding: 6px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #D1D5DB;
    border-radius: 9px;
    background-color: white;
}

QRadioButton::indicator:checked {
    background-color: #2563EB;
    border-color: #2563EB;
}

QRadioButton::indicator:hover {
    border-color: #2563EB;
}

QDialogButtonBox QPushButton {
    min-width: 80px;
    padding: 8px 16px;
}

/* ============================================================================
   MESSAGE BOX - Clean
   ============================================================================ */

QMessageBox {
    background-color: white;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 8px 16px;
}
