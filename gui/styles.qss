/* 
 * Lab-untuk-OCR Professional UI Stylesheet
 * Design: Clean, Flat, Modern, No Gradients
 * Following Microsoft Fluent & Material Design principles
 */

/* ============================================================================
   GLOBAL - Clean Background
   ============================================================================ */

QMainWindow {
    background-color: #F5F7FA;
}

QWidget {
    font-family: -apple-system, "Segoe UI", "Roboto", sans-serif;
    font-size: 10pt;
    color: #1E293B;
}

/* ============================================================================
   BUTTONS - Flat Professional Design
   ============================================================================ */

QPushButton {
    background-color: #3B82F6;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px 24px;
    font-weight: 600;
    font-size: 10pt;
    min-height: 40px;
}

QPushButton:hover {
    background-color: #2563EB;
}

QPushButton:pressed {
    background-color: #1E40AF;
}

QPushButton:disabled {
    background-color: #CBD5E1;
    color: #94A3B8;
}

/* Browse Button - Outline Style */
QPushButton#browse_btn {
    background-color: #FFFFFF;
    color: #3B82F6;
    border: 2px solid #3B82F6;
}

QPushButton#browse_btn:hover {
    background-color: #EFF6FF;
    border: 2px solid: #2563EB;
}

QPushButton#browse_btn:pressed {
    background-color: #DBEAFE;
}

/* Start Button - Success Color */
QPushButton#start_btn {
    background-color: #10B981;
    color: white;
}

QPushButton#start_btn:hover {
    background-color: #059669;
}

QPushButton#start_btn:pressed {
    background-color: #047857;
}

QPushButton#start_btn:disabled {
    background-color: #CBD5E1;
    color: #94A3B8;
}

/* Reset Button - Outline Warning */
QPushButton#reset_btn {
    background-color: #FFFFFF;
    color: #DC2626;
    border: 2px solid #DC2626;
}

QPushButton#reset_btn:hover {
    background-color: #FEF2F2;
    border: 2px solid #B91C1C;
}

QPushButton#reset_btn:pressed {
    background-color: #FEE2E2;
}

QPushButton#reset_btn:disabled {
    background-color: #F8FAFC;
    color: #CBD5E1;
    border: 2px solid #CBD5E1;
}

/* Export Button - Accent Color */
QPushButton#exportButton {
    background-color: #8B5CF6;
    color: white;
}

QPushButton#exportButton:hover {
    background-color: #7C3AED;
}

QPushButton#exportButton:pressed {
    background-color: #6D28D9;
}

/* ============================================================================
   GROUP BOX - Clean Cards
   ============================================================================ */

QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 24px;
    margin-top: 16px;
    font-weight: 700;
    font-size: 12pt;
    color: #0F172A;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 16px;
    background-color: #F8FAFC;
    border-radius: 6px;
    color: #0F172A;
}

/* ============================================================================
   TABLE - Professional Clean
   ============================================================================ */

QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    gridline-color: #E2E8F0;
    selection-background-color: #DBEAFE;
    selection-color: #0F172A;
}

QTableWidget::item {
    padding: 12px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #DBEAFE;
}

QTableWidget::item:hover {
    background-color: #F1F5F9;
}

QTableWidget::item:focus {
    background-color: #BFDBFE;
    outline: none;
}

/* Table Header - Clean Professional */
QHeaderView::section {
    background-color: #F8FAFC;
    color: #475569;
    padding: 14px 12px;
    border: none;
    border-bottom: 2px solid #CBD5E1;
    border-right: 1px solid #E2E8F0;
    font-weight: 700;
    font-size: 9pt;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QHeaderView::section:hover {
    background-color: #F1F5F9;
}

/* Vertical Header (Row Numbers) */
QHeaderView::section:vertical {
    background-color: #EFF6FF;
    color: #3B82F6;
    font-weight: 700;
    font-size: 10pt;
}

/* ============================================================================
   PROGRESS BAR - Clean Modern
   ============================================================================ */

QProgressBar {
    background-color: #F1F5F9;
    border: 1px solid #CBD5E1;
    border-radius: 10px;
    text-align: center;
    height: 32px;
    font-size: 10pt;
    font-weight: 600;
    color: #0F172A;
}

QProgressBar::chunk {
    background-color: #3B82F6;
    border-radius: 9px;
}

/* ============================================================================
   STATUS BAR - Minimal Clean
   ============================================================================ */

QStatusBar {
    background-color: #F8FAFC;
    color: #64748B;
    border-top: 1px solid #E2E8F0;
    font-size: 9pt;
    padding: 8px 12px;
}

/* ============================================================================
   SCROLL BAR - Modern Minimal
   ============================================================================ */

QScrollBar:vertical {
    background-color: #F1F5F9;
    width: 14px;
    border-radius: 7px;
    margin: 4px;
}

QScrollBar::handle:vertical {
    background-color: #94A3B8;
    border-radius: 7px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background-color: #64748B;
}

QScrollBar:horizontal {
    background-color: #F1F5F9;
    height: 14px;
    border-radius: 7px;
    margin: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #94A3B8;
    border-radius: 7px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #64748B;
}

QScrollBar::add-line, QScrollBar::sub-line {
    background: none;
    border: none;
}

/* ============================================================================
   LABELS - Clear Hierarchy
   ============================================================================ */

QLabel {
    color: #334155;
    font-weight: 500;
}

/* ============================================================================
   DIALOG - Clean Professional
   ============================================================================ */

QDialog {
    background-color: #FFFFFF;
}

QRadioButton {
    color: #334155;
    spacing: 10px;
    padding: 8px;
    font-weight: 500;
}

QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #94A3B8;
    border-radius: 10px;
    background-color: #FFFFFF;
}

QRadioButton::indicator:checked {
    background-color: #3B82F6;
    border-color: #3B82F6;
}

QRadioButton::indicator:hover {
    border-color: #3B82F6;
    background-color: #EFF6FF;
}

QDialogButtonBox QPushButton {
    min-width: 100px;
    padding: 10px 20px;
}

/* ============================================================================
   MESSAGE BOX - Clean
   ============================================================================ */

QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QPushButton {
    min-width: 100px;
    padding: 10px 20px;
}

/* ============================================================================
   TOOLTIPS - Professional
   ============================================================================ */

QToolTip {
    background-color: #1E293B;
    color: #FFFFFF;
    border: 1px solid #475569;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 9pt;
}

/* ============================================================================
   ADDITIONAL POLISH
   ============================================================================ */

/* File Dialog */
QFileDialog {
    background-color: #F8FAFC;
}

/* Input Fields (if used) */
QLineEdit {
    background-color: #FFFFFF;
    border: 2px solid #E2E8F0;
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 10pt;
    color: #1E293B;
}

QLineEdit:focus {
    border: 2px solid #3B82F6;
}

QLineEdit:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
}
