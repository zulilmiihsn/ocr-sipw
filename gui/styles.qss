/* 
 * OCR SiPW - Professional Native Desktop UI
 * Design: Native Desktop Application Style
 * Color: Professional Blue (#2563EB) with refined palette
 */

/* ============================================================================
   GLOBAL - Professional Native Desktop
   ============================================================================ */

QMainWindow {
    background-color: #F5F7FA;
}

QWidget {
    font-family: "Segoe UI", "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 9pt;
    color: #1E293B;
    font-weight: 400;
}

/* ============================================================================
   BUTTONS - Native Desktop Professional
   ============================================================================ */

QPushButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: 600;
    font-size: 9pt;
    min-height: 38px;
}

QPushButton:hover {
    background-color: #1D4ED8;
}

QPushButton:pressed {
    background-color: #1E40AF;
    padding-top: 11px;
    padding-bottom: 9px;
}

QPushButton:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
    font-weight: 400;
}

/* Secondary Button Style - Native Desktop */
QPushButton#browse_btn,
QPushButton#reset_btn {
    background-color: #FFFFFF;
    color: #475569;
    border: 1.5px solid #E2E8F0;
    font-weight: 500;
}

QPushButton#browse_btn:hover,
QPushButton#reset_btn:hover {
    background-color: #F8FAFC;
    border: 1.5px solid #2563EB;
    color: #2563EB;
}

QPushButton#browse_btn:pressed,
QPushButton#reset_btn:pressed {
    background-color: #F1F5F9;
    border: 1.5px solid #1D4ED8;
}

QPushButton#browse_btn:disabled,
QPushButton#reset_btn:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
    border: 1.5px solid #F1F5F9;
}

/* Sort Button Style - Native Desktop */
QPushButton#sort_btn {
    background-color: #FFFFFF;
    color: #2563EB;
    border: 1.5px solid #2563EB;
    font-weight: 500;
}

QPushButton#sort_btn:hover {
    background-color: #EFF6FF;
    border: 1.5px solid #1D4ED8;
    color: #1D4ED8;
}

QPushButton#sort_btn:pressed {
    background-color: #DBEAFE;
    border: 1.5px solid #1E40AF;
}

QPushButton#sort_btn:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
    border: 1.5px solid #F1F5F9;
}

/* Icon Button Style - Native Desktop */
QPushButton#icon_btn {
    background-color: transparent;
    border: 1px solid #E2E8F0;
    border-radius: 4px;
    padding: 6px;
    min-height: 32px;
    min-width: 32px;
}

QPushButton#icon_btn:hover {
    background-color: #F8FAFC;
    border: 1px solid #CBD5E1;
}

QPushButton#icon_btn:pressed {
    background-color: #F1F5F9;
    border: 1px solid #94A3B8;
}

QPushButton#icon_btn:disabled {
    background-color: transparent;
    border: 1px solid #F1F5F9;
    opacity: 0.4;
}

/* Floating Button Style - Native Desktop */
QPushButton#floating_btn {
    background-color: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(226, 232, 240, 0.8);
    border-radius: 3px;
    padding: 3px;
    min-height: 20px;
    min-width: 20px;
    max-height: 20px;
    max-width: 20px;
}

QPushButton#floating_btn:hover {
    background-color: rgba(255, 255, 255, 1.0);
    border: 1px solid #CBD5E1;
}

QPushButton#floating_btn:pressed {
    background-color: #F1F5F9;
    border: 1px solid #94A3B8;
}

/* ============================================================================
   GROUP BOX - Native Desktop Professional
   ============================================================================ */

QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 24px 20px 20px 20px;
    margin-top: 16px;
    font-weight: 600;
    font-size: 10.5pt;
    color: #1E293B;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    margin-left: 12px;
    background-color: #FFFFFF;
    color: #1E293B;
    font-weight: 600;
    font-size: 10.5pt;
    letter-spacing: 0.2px;
}

/* ============================================================================
   TABLE - Native Desktop Professional
   ============================================================================ */

QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 0px;
    gridline-color: #F1F5F9;
    selection-background-color: #EFF6FF;
    selection-color: #1E293B;
    font-size: 8.5pt;
    font-weight: 400;
}

QTableWidget::item {
    padding: 6px 8px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #EFF6FF;
    color: #1E293B;
    font-weight: 400;
}

QTableWidget::item:hover {
    background-color: #F8FAFC;
}

QTableWidget::item:focus {
    background-color: #DBEAFE;
    outline: 2px solid #2563EB;
    outline-offset: -2px;
}

/* Table Header - Native Desktop Professional */
QHeaderView::section {
    background-color: #FAFBFC;
    color: #475569;
    padding: 12px 10px;
    border: none;
    border-right: 1px solid #E2E8F0;
    border-bottom: 2px solid #E2E8F0;
    font-weight: 600;
    font-size: 8pt;
    letter-spacing: 0.1px;
    line-height: 1.4;
    min-height: 52px;
    text-transform: none;
}

QHeaderView::section:hover {
    background-color: #F5F7FA;
}

QHeaderView::section:first {
    border-top-left-radius: 0px;
}

QHeaderView::section:last {
    border-top-right-radius: 0px;
    border-right: none;
}

/* Vertical Header - Native Desktop */
QHeaderView::section:vertical {
    background-color: #FAFBFC;
    color: #64748B;
    font-weight: 600;
    font-size: 8.5pt;
    padding: 4px 6px;
    border-right: 2px solid #E2E8F0;
    border-bottom: 1px solid #E2E8F0;
    max-width: 40px;
    text-align: center;
}

/* ============================================================================
   PROGRESS BAR - Native Desktop Professional
   ============================================================================ */

QProgressBar {
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    text-align: center;
    height: 30px;
    font-size: 8.5pt;
    font-weight: 600;
    color: #2563EB;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #3B82F6, stop:1 #2563EB);
    border-radius: 5px;
    margin: 1px;
}

/* ============================================================================
   STATUS BAR - Native Desktop Professional
   ============================================================================ */

QStatusBar {
    background-color: #FFFFFF;
    color: #64748B;
    border-top: 1px solid #E2E8F0;
    font-size: 8.5pt;
    font-weight: 400;
    padding: 8px 16px;
    min-height: 28px;
}

/* ============================================================================
   SCROLL BAR - Native Desktop Professional
   ============================================================================ */

QScrollBar:vertical {
    background-color: #FAFBFC;
    width: 12px;
    border-radius: 0px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #CBD5E1;
    border-radius: 6px;
    min-height: 40px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #94A3B8;
}

QScrollBar::handle:vertical:pressed {
    background-color: #64748B;
}

QScrollBar:horizontal {
    background-color: #FAFBFC;
    height: 12px;
    border-radius: 0px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #CBD5E1;
    border-radius: 6px;
    min-width: 40px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #94A3B8;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #64748B;
}

QScrollBar::add-line, QScrollBar::sub-line {
    background: none;
    border: none;
    width: 0px;
    height: 0px;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ============================================================================
   LABELS - Native Desktop Typography
   ============================================================================ */

QLabel {
    color: #64748B;
    font-weight: 400;
    font-size: 9pt;
}

/* ============================================================================
   DIALOG - Native Desktop Professional
   ============================================================================ */

QDialog {
    background-color: #FFFFFF;
}

QRadioButton {
    color: #475569;
    spacing: 10px;
    padding: 8px;
    font-weight: 400;
    font-size: 9pt;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #CBD5E1;
    border-radius: 9px;
    background-color: #FFFFFF;
}

QRadioButton::indicator:checked {
    background-color: #2563EB;
    border-color: #2563EB;
}

QRadioButton::indicator:hover {
    border-color: #94A3B8;
}

QDialogButtonBox QPushButton {
    min-width: 85px;
    padding: 9px 18px;
    font-weight: 500;
}

/* ============================================================================
   MESSAGE BOX - Native Desktop Professional
   ============================================================================ */

QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #1E293B;
    font-size: 9pt;
    font-weight: 400;
    line-height: 1.5;
}

QMessageBox QPushButton {
    min-width: 85px;
    padding: 9px 18px;
    font-weight: 500;
}

/* ============================================================================
   TOOLTIPS - Native Desktop Professional
   ============================================================================ */

QToolTip {
    background-color: #1E293B;
    color: #F8FAFC;
    border: none;
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 8.5pt;
    font-weight: 400;
}

/* ============================================================================
   INPUT FIELDS - Native Desktop Professional
   ============================================================================ */

QLineEdit {
    background-color: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 9pt;
    font-weight: 400;
    color: #1E293B;
    selection-background-color: #DBEAFE;
    selection-color: #1E293B;
}

QLineEdit:focus {
    border: 1.5px solid #2563EB;
    outline: none;
}

QLineEdit:hover {
    border: 1.5px solid #CBD5E1;
}

QLineEdit:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
    border: 1.5px solid #F1F5F9;
}

/* ============================================================================
   LIST WIDGET - Native Desktop Professional
   ============================================================================ */

QListWidget {
    background-color: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 6px;
    padding: 6px;
    font-size: 9pt;
    outline: none;
}

QListWidget::item {
    padding: 8px 12px;
    border-radius: 4px;
    margin: 2px 0px;
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
}

QListWidget::item:hover {
    background-color: #F1F5F9;
    border: 1px solid #CBD5E1;
}

QListWidget::item:selected {
    background-color: #DBEAFE;
    color: #1E293B;
    border: 1.5px solid #2563EB;
    font-weight: 500;
}

/* ============================================================================
   FILE DIALOG - Native Desktop Professional
   ============================================================================ */

QFileDialog {
    background-color: #FFFFFF;
}
