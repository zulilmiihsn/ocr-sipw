/* 
 * Lab-untuk-OCR - Professional Clean UI
 * Design: Minimal, Clean, Enterprise-grade
 * Color: Single Professional Blue (#2563EB)
 */

/* ============================================================================
   GLOBAL - Clean Professional
   ============================================================================ */

QMainWindow {
    background-color: #FFFFFF;
}

QWidget {
    font-family: "Segoe UI", "Inter", -apple-system, sans-serif;
    font-size: 9pt;
    color: #334155;
}

/* ============================================================================
   BUTTONS - Minimal Professional
   ============================================================================ */

QPushButton {
    background-color: #2563EB;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 10px 20px;
    font-weight: 500;
    font-size: 9pt;
    min-height: 36px;
}

QPushButton:hover {
    background-color: #1D4ED8;
}

QPushButton:pressed {
    background-color: #1E40AF;
}

QPushButton:disabled {
    background-color: #F1F5F9;
    color: #CBD5E1;
}

/* Secondary Button Style */
QPushButton#browse_btn,
QPushButton#reset_btn {
    background-color: #FFFFFF;
    color: #475569;
    border: 1px solid #E2E8F0;
}

QPushButton#browse_btn:hover,
QPushButton#reset_btn:hover {
    background-color: #F8FAFC;
    border: 1px solid #CBD5E1;
}

QPushButton#browse_btn:pressed,
QPushButton#reset_btn:pressed {
    background-color: #F1F5F9;
}

QPushButton#browse_btn:disabled,
QPushButton#reset_btn:disabled {
    background-color: #FFFFFF;
    color: #E2E8F0;
    border: 1px solid #F1F5F9;
}

/* ============================================================================
   GROUP BOX - Minimal Clean
   ============================================================================ */

QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 4px;
    padding: 16px;
    margin-top: 8px;
    font-weight: 500;
    font-size: 9pt;
    color: #475569;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 8px;
    background-color: transparent;
    color: #64748B;
    font-weight: 500;
    font-size: 8pt;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ============================================================================
   TABLE - Professional Clean
   ============================================================================ */

QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 0px;
    gridline-color: #F1F5F9;
    selection-background-color: #EFF6FF;
    selection-color: #1E293B;
    font-size: 8pt;
}

QTableWidget::item {
    padding: 4px 6px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #EFF6FF;
    color: #1E293B;
    font-weight: 400;
}

QTableWidget::item:hover {
    background-color: #F8FAFC;
}

QTableWidget::item:focus {
    background-color: #DBEAFE;
    outline: none;
}

/* Table Header - Clean Professional */
QHeaderView::section {
    background-color: #F8FAFC;
    color: #475569;
    padding: 6px 4px;
    border: none;
    border-right: 1px solid #E2E8F0;
    border-bottom: 1px solid #E2E8F0;
    font-weight: 500;
    font-size: 7pt;
    text-transform: uppercase;
    letter-spacing: 0.3px;
}

QHeaderView::section:hover {
    background-color: #F1F5F9;
}

QHeaderView::section:first {
    border-top-left-radius: 0px;
}

QHeaderView::section:last {
    border-top-right-radius: 0px;
    border-right: none;
}

/* Vertical Header - Minimal Clean */
QHeaderView::section:vertical {
    background-color: #F8FAFC;
    color: #64748B;
    font-weight: 500;
    font-size: 8pt;
    padding: 2px 4px;
    border-right: 1px solid #E2E8F0;
    border-bottom: 1px solid #E2E8F0;
    max-width: 35px;
}

/* ============================================================================
   PROGRESS BAR - Minimal Professional
   ============================================================================ */

QProgressBar {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 2px;
    text-align: center;
    height: 24px;
    font-size: 8pt;
    font-weight: 500;
    color: #64748B;
}

QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 2px;
}

/* ============================================================================
   STATUS BAR - Minimal Clean
   ============================================================================ */

QStatusBar {
    background-color: #F8FAFC;
    color: #64748B;
    border-top: 1px solid #E2E8F0;
    font-size: 8pt;
    font-weight: 400;
    padding: 6px 12px;
}

/* ============================================================================
   SCROLL BAR - Minimal
   ============================================================================ */

QScrollBar:vertical {
    background-color: #FFFFFF;
    width: 10px;
    border-radius: 0px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #CBD5E1;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #94A3B8;
}

QScrollBar:horizontal {
    background-color: #FFFFFF;
    height: 10px;
    border-radius: 0px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #CBD5E1;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #94A3B8;
}

QScrollBar::add-line, QScrollBar::sub-line {
    background: none;
    border: none;
}

/* ============================================================================
   LABELS - Clean Typography
   ============================================================================ */

QLabel {
    color: #64748B;
    font-weight: 400;
}

/* ============================================================================
   DIALOG - Professional Clean
   ============================================================================ */

QDialog {
    background-color: #FFFFFF;
}

QRadioButton {
    color: #475569;
    spacing: 8px;
    padding: 6px;
    font-weight: 400;
    font-size: 9pt;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #CBD5E1;
    border-radius: 8px;
    background-color: #FFFFFF;
}

QRadioButton::indicator:checked {
    background-color: #2563EB;
    border-color: #2563EB;
}

QRadioButton::indicator:hover {
    border-color: #94A3B8;
}

QDialogButtonBox QPushButton {
    min-width: 80px;
    padding: 8px 16px;
    font-weight: 500;
}

/* ============================================================================
   MESSAGE BOX - Professional
   ============================================================================ */

QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #1E293B;
    font-size: 9pt;
    font-weight: 400;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 8px 16px;
    font-weight: 500;
}

/* ============================================================================
   TOOLTIPS - Minimal
   ============================================================================ */

QToolTip {
    background-color: #1E293B;
    color: #F8FAFC;
    border: none;
    border-radius: 2px;
    padding: 6px 10px;
    font-size: 8pt;
    font-weight: 400;
}

/* ============================================================================
   INPUT FIELDS - Clean Professional
   ============================================================================ */

QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 9pt;
    font-weight: 400;
    color: #1E293B;
}

QLineEdit:focus {
    border: 1px solid #2563EB;
}

QLineEdit:hover {
    border: 1px solid #CBD5E1;
}

QLineEdit:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
    border: 1px solid #F1F5F9;
}
