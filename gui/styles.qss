/* 
 * Lab-untuk-OCR - Professional UI
 * Design: Clean, Minimal, Corporate
 * Single Color Theme: Professional Blue
 */

/* ============================================================================
   GLOBAL - Professional Clean Background
   ============================================================================ */

QMainWindow {
    background-color: #F8FAFC;
}

QWidget {
    font-family: "Segoe UI", -apple-system, "Inter", sans-serif;
    font-size: 10pt;
    color: #1E293B;
}

/* ============================================================================
   BUTTONS - Professional Style
   ============================================================================ */

QPushButton {
    background-color: #2563EB;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px 24px;
    font-weight: 600;
    font-size: 10pt;
    min-height: 42px;
}

QPushButton:hover {
    background-color: #1D4ED8;
}

QPushButton:pressed {
    background-color: #1E40AF;
}

QPushButton:disabled {
    background-color: #E2E8F0;
    color: #94A3B8;
}

/* Secondary Button Style */
QPushButton#browse_btn,
QPushButton#reset_btn {
    background-color: #FFFFFF;
    color: #2563EB;
    border: 2px solid #2563EB;
}

QPushButton#browse_btn:hover,
QPushButton#reset_btn:hover {
    background-color: #EFF6FF;
    border: 2px solid #1D4ED8;
    color: #1D4ED8;
}

QPushButton#browse_btn:pressed,
QPushButton#reset_btn:pressed {
    background-color: #DBEAFE;
    border: 2px solid #1E40AF;
}

QPushButton#browse_btn:disabled,
QPushButton#reset_btn:disabled {
    background-color: #F8FAFC;
    color: #CBD5E1;
    border: 2px solid #E2E8F0;
}

/* ============================================================================
   GROUP BOX - Professional Card Style
   ============================================================================ */

QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 12px;
    margin-top: 12px;
    font-weight: 600;
    font-size: 10pt;
    color: #0F172A;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 12px;
    background-color: #2563EB;
    color: #FFFFFF;
    border-radius: 6px;
    font-weight: 600;
    font-size: 10pt;
}

/* ============================================================================
   TABLE - Professional Clean Design
   ============================================================================ */

QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    gridline-color: #F1F5F9;
    selection-background-color: #EFF6FF;
    selection-color: #1E293B;
    font-size: 8pt;
}

QTableWidget::item {
    padding: 6px 4px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #DBEAFE;
    color: #1E40AF;
    font-weight: 500;
}

QTableWidget::item:hover {
    background-color: #F8FAFC;
}

QTableWidget::item:focus {
    background-color: #BFDBFE;
    outline: none;
}

/* Table Header - Professional Compact */
QHeaderView::section {
    background-color: #475569;
    color: #FFFFFF;
    padding: 8px 4px;
    border: none;
    border-right: 1px solid #64748B;
    border-bottom: 2px solid #2563EB;
    font-weight: 600;
    font-size: 8pt;
}

QHeaderView::section:hover {
    background-color: #64748B;
}

QHeaderView::section:first {
    border-top-left-radius: 8px;
}

QHeaderView::section:last {
    border-top-right-radius: 8px;
    border-right: none;
}

/* Vertical Header - Clean Blue Compact */
QHeaderView::section:vertical {
    background-color: #2563EB;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 9pt;
    padding: 4px 8px;
    border-right: 2px solid #1D4ED8;
    border-bottom: 1px solid #3B82F6;
}

/* ============================================================================
   PROGRESS BAR - Professional Style
   ============================================================================ */

QProgressBar {
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    text-align: center;
    height: 32px;
    font-size: 10pt;
    font-weight: 600;
    color: #1E293B;
}

QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 8px;
}

/* ============================================================================
   STATUS BAR - Professional Clean
   ============================================================================ */

QStatusBar {
    background-color: #475569;
    color: #E2E8F0;
    border: none;
    font-size: 9pt;
    font-weight: 500;
    padding: 8px 16px;
}

/* ============================================================================
   SCROLL BAR - Minimal Professional
   ============================================================================ */

QScrollBar:vertical {
    background-color: #F8FAFC;
    width: 12px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #94A3B8;
    border-radius: 6px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background-color: #64748B;
}

QScrollBar:horizontal {
    background-color: #F8FAFC;
    height: 12px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #94A3B8;
    border-radius: 6px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #64748B;
}

QScrollBar::add-line, QScrollBar::sub-line {
    background: none;
    border: none;
}

/* ============================================================================
   LABELS - Professional Typography
   ============================================================================ */

QLabel {
    color: #475569;
    font-weight: 500;
}

/* ============================================================================
   DIALOG - Professional Clean
   ============================================================================ */

QDialog {
    background-color: #FFFFFF;
}

QRadioButton {
    color: #1E293B;
    spacing: 8px;
    padding: 8px;
    font-weight: 500;
    font-size: 10pt;
}

QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #94A3B8;
    border-radius: 10px;
    background-color: #FFFFFF;
}

QRadioButton::indicator:checked {
    background-color: #2563EB;
    border-color: #2563EB;
}

QRadioButton::indicator:hover {
    border-color: #2563EB;
}

QDialogButtonBox QPushButton {
    min-width: 100px;
    padding: 10px 20px;
    font-weight: 600;
}

/* ============================================================================
   MESSAGE BOX - Professional
   ============================================================================ */

QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #0F172A;
    font-size: 10pt;
    font-weight: 500;
}

QMessageBox QPushButton {
    min-width: 100px;
    padding: 10px 20px;
    font-weight: 600;
}

/* ============================================================================
   TOOLTIPS - Professional Minimal
   ============================================================================ */

QToolTip {
    background-color: #1E293B;
    color: #FFFFFF;
    border: 1px solid #475569;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 9pt;
    font-weight: 500;
}

/* ============================================================================
   INPUT FIELDS - Professional Clean
   ============================================================================ */

QLineEdit {
    background-color: #FFFFFF;
    border: 2px solid #E2E8F0;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 10pt;
    font-weight: 500;
    color: #1E293B;
}

QLineEdit:focus {
    border: 2px solid #2563EB;
}

QLineEdit:hover {
    border: 2px solid #CBD5E1;
}

QLineEdit:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
    border: 2px solid #E2E8F0;
}
